# Server-side only. Never expose these to the browser.
ASTEROID_API_KEY=
ASTEROID_ORGANIZATION_ID=
ASTEROID_TEMPLATE_ID=

# Optional. Defaults to production.
ASTEROID_API_URL=https://odyssey.asteroid.ai
# The browser calls the public endpoints directly, so the page needs the base URL too.
NEXT_PUBLIC_ASTEROID_API_URL=https://odyssey.asteroid.ai
